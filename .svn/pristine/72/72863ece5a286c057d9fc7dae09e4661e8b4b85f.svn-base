<body class =" bg-gradient-to-b from-gray-900 to-gray-800">
    <div class="mx-auto min-h-screen max-w-screen-xl bg-gradient-to-b from-gray-900 to-gray-800 px-8 py-16 text-white">
        <div class="max-w-3xl mx-auto">
          <h5 class="font-semibold uppercase tracking-wide text-gray-500 dark:text-slate-400">Privacy & Data</h5>
          <section class="mb-9">
            <h1 class="mb-4 text-4xl font-bold">Data Management & Your Security</h1>
            <p class="text-gray-300 text-xl">Synergy+ places utmost importance on your data's security. All sensitive data is kept between your device and the Synergy servers. However, to provide clarity, here's an overview of the data Synergy+ uses and its purpose.</p>
          </section>
          <section class="mb-5">
            <h2 class="mb-4 text-3xl font-bold">How Synergy+ handles your data</h2>
            <p class="text-gray-300">Some nerd shit</p>
          </section>
          <section class="mb-8">
            <h2 class="text-2xl font-bold text-white mb-4">Data Handling Roadmap</h2>
            <div class="flex items-center space-x-6">
              <div class="relative">
                <div class="absolute h-full w-1 bg-gray-700 left-5"></div>
                <div class="flex-grow bg-gray-700 rounded-lg shadow-md p-6 hover:bg-teal-500 hover:text-white transition duration-300 transform hover:-translate-y-1 hover:scale-105">
                  <p class="text-gray-300 text-base">Step 1: Data Collection</p>
                </div>
              </div>
              <div class="relative">
                <div class="absolute h-full w-1 bg-gray-700 left-5"></div>
                <div class="flex-grow bg-gray-700 rounded-lg shadow-md p-6 hover:bg-teal-500 hover:text-white transition duration-300 transform hover:-translate-y-1 hover:scale-105">
                  <p class="text-gray-300 text-base">Step 2: Data Encryption</p>
                </div>
              </div>
              <div class="relative">
                <div class="absolute h-full w-1 bg-gray-700 left-5"></div>
                <div class="flex-grow bg-gray-700 rounded-lg shadow-md p-6 hover:bg-teal-500 hover:text-white transition duration-300 transform hover:-translate-y-1 hover:scale-105">
                  <p class="text-gray-300 text-base">Step 3: Secure Storage</p>
                </div>
              </div>
              <!-- Add more steps if needed -->
            </div>
          </section>
          <section class="mb-8">
            <h2 class="text-2xl font-bold text-white">TLDR</h2>
            <p class="text-gray-300 mt-2">Synergy+ ensures the security of your data by keeping sensitive information between your device and the Synergy servers.</p>
          </section>
          <p class="text-gray-300">Feel free to reach out to us with any questions or suggestions!</p>
        </div>
      </div>
</body>

