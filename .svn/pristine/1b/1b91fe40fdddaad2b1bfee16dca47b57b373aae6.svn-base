<!DOCTYPE html>
<html>
<head>
<meta charset='UTF-8'>
  <title>Sign In • Synergy+</title>
  <meta name='viewport' content='width=device-width,initial-scale=1'>
  <link href='favicon.ico' rel='icon' type='icon/ico'>
  <link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css' integrity='sha256-OweaP/Ic6rsV+lysfyS4h+LM6sRwuO3euTYfr6M124g=' crossorigin='anonymous'/>
  <link rel='stylesheet' href='css/auth.css' type='text/css'>


  <script defer src='js/zepto.min.js' integrity='sha256-RHTXmWrHQAbYRTGQR8NJapj1bG53Zh4oRZRuAy2Hu3A=' crossorigin='anonymous'></script>
  <script defer src='https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js' integrity='sha256-U/cHDMTIHCeMcvehBv1xQ052bPSbJtbuiw4QA9cTKz0=' crossorigin='anonymous'></script>
  <script defer src='js/ver.js'></script>
  <script defer src='js/signin.js'></script>
  <script defer src='js/wa-client.js'></script>
  <script async src='https://unpkg.com/animejs@3.0.1/lib/anime.min.js'></script>
  <noscript><style>#div-msg{opacity:1; height: 96px; margin-top: 10px; padding: 3px 6px} input, button, label {display: none !important}</style></noscript>

  <link href="/dist/output.css" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.8.0/flowbite.min.css" rel="stylesheet" />

  <script>
    tailwind.config = {
  darkMode: 'media',
  theme: {
    extend: {
      colors: {
        primary: {"50":"#eff6ff","100":"#dbeafe","200":"#bfdbfe","300":"#93c5fd","400":"#60a5fa","500":"#3b82f6","600":"#2563eb","700":"#1d4ed8","800":"#1e40af","900":"#1e3a8a","950":"#172554"}
      }
    },
    fontFamily: {
      'body': [
    'Inter', 
    'ui-sans-serif', 
    'system-ui', 
    '-apple-system', 
    'system-ui', 
    'Segoe UI', 
    'Roboto', 
    'Helvetica Neue', 
    'Arial', 
    'Noto Sans', 
    'sans-serif', 
    'Apple Color Emoji', 
    'Segoe UI Emoji', 
    'Segoe UI Symbol', 
    'Noto Color Emoji'
  ],
      'sans': [
    'Inter', 
    'ui-sans-serif', 
    'system-ui', 
    '-apple-system', 
    'system-ui', 
    'Segoe UI', 
    'Roboto', 
    'Helvetica Neue', 
    'Arial', 
    'Noto Sans', 
    'sans-serif', 
    'Apple Color Emoji', 
    'Segoe UI Emoji', 
    'Segoe UI Symbol', 
    'Noto Color Emoji'
  ]
    }
  }
}
  </script>

</head>

<body>

  <section class="bg-gray-50 dark:bg-gray-900">

    
<div class = "grid h-screen w-full">
  <div class="flex min-h-screen flex-col justify-center bg-gray-800">
    
    <div
    class="mx-auto w-full max-w-[400px] rounded-lg bg-gray-900 p-8 px-8 shadow-xl"
    > 
    
    <img src="https://synergy-plus.vercel.app/static/media/synergyplus.66a8d0c1367f658c0c37.png" alt="Logo" class="mx-auto mb--4 block" />

    <div id='login-div' class="flex flex-col py-2 text-gray-400">
      <div class='p-6 space-y-4 md:space-y-6 sm:p-8' id='ccL'>
        <br/>
        <noscript>
          <div>
            <b>Error:</b>
            <span>JavaScript is disabled (29).<br>Synergy+ can not be used without JavaScript.<br><br>If you need help enabling JavaScript, <a href='https://enable-javascript.com'>click here</a>.</span>
          </div>
        </noscript>
      </div>


        
        
        <div class = "flex flex-col py-2 text-gray-400">
          <label id='l_user' for='i_user' >Username</label>
          <input id='i_user' type='text' maxlength='24' class='validate'>
          
        </div>
        
        <div class='flex flex-col py-2 text-gray-400'>
          <label for='i_pass'>Password</label>
          <input id='i_pass' type='password' maxlength='48' class='mt-2 rounded-lg bg-gray-700 p-2 focus:border-blue-500 focus:bg-gray-800 focus:outline-none" type="text" onchange="(e) => setEmail(e.target.value)'>
        </div>

        <div class='input-field'>
          <label for='div-domain' class='active'>Domain / District</label>
          <div id='div-domain' tabindex='0' data-target='drop-domain-ul' onclick='showDrop()'>
            <span id='s-domain'></span>
            <span id='s-domainURL'></span>
          </div>
        </div>
        <label>
          <input id='c_rem' type='checkbox' checked/>
          <span class = "mt-2 my-2">Remember Me</span>
        </label>
        <button onclick='login(); consent(1)' class="w-full text-white bg-primary-600 hover:bg-primary-700 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">Continue</button>
        <a href='app/start?persist=1' id='lnk-app' style='display: none'><button class='btn btn-flat right blue-grey darken-1 waves-effect waves-effect white-text' style='margin-right: 4px'>Back</button></a>
        <br>
      <div class='card-content' id='ccWA'>
        <span class='card-title'><img id='title-icon' src=''> Sign In with WebAuth</span>
        <div class='domain' tabindex='0' onkeypress='selDomain(this)' onclick='selDomain(this)'>
          <span class='domainName'>Sign in with an external security key</span>
        </div>
      </div>
      <div class='card-content' id='cc2'>
        <span class='card-title'><img id='title-icon' src=''> Synergy+</span>
        <p>Looks like you haven't used Synergy+ yet this school year. Welcome!</p>
        <br>
        <p>A new Synergy+ account will be linked to your StudentVUE account. Please confirm the following information is accurate before continuing.</p>
        <br>
        <p>Legal Name: <b><span id='cc2_name'></span></b><br>School: <b><span id='cc2_school'></span></b></p>
        <br>
        <br>
        <button onclick='consent(2)' class='btn btn-flat right blue white-text waves-effect'>Continue</button>
        <button onclick='consent(0)' class='btn btn-flat right grey white-text waves-effect' style='margin-right: 5px'>Cancel</button>
        <br>
      </div>

      <div id='ccD'>
        <span class='card-title'><img id='title-icon' src=''> District Selection</span>
        <div class='domain' tabindex='0' onkeypress='selDomain(this)' onclick='selDomain(this)'>
          <span class='domainName'>Pleasanton Unified School District</span>
          <span class='domainURL'>ca-pleas-psv.edupoint.com</span>
        </div>
      </div>

      <div class='card-content' id='cc3'>
        <span class='card-title'>Legal</span>
        <div id='div-msg2'>
          <b>Error:</b>
          <span id='msg2-content'>The request failed.</span>
        </div>
        <p><b>Synergy+ works by communicating with Synergy SIS. No data is ever transferred to a central server -- everything is kept on your personal device.</p>
        <br/>
        <p><b>Don't be a nerd and misuse this!</b></p>
        <div class='input-field'>
          <input id='i_signature' type='text' maxlength='48' onchange='tosAcc.disabled=false' class='validate'>
          <label for='i_signature'>Your Display Name</label>
        </div>
        <br>
        <label>
          <input id='c_tos' type='checkbox' onchange='tosAcc.disabled=false'/>
          <span>I accept.</span>
        </label>
        <br>
        <br>
        <button id='tosAcc' disabled onclick='consent(1)' class='btn btn-flat right blue white-text waves-effect'>Continue</button>
        <button id='tosAccCancel' onclick='consent(0)' class='btn btn-flat right teal white-text waves-effect' style='margin-right: 5px'>Sign Out</button>
        <br>
      </div>
      <div class='card-content' id='cc4'>
        <span class='card-title'>Success!</span>
        <p>Your account has been successfully created. <br>Welcome to Synergy+, <span id='cc4_name'></span>!</p>
        <br>
        <p>If you have any questions, suggestions, or comments, please email Synergy+pusd@gmail.com. Thanks!!</p>
        <br>
        <button onclick='window.open("../dashboard","_self")' class='btn btn-flat right blue white-text waves-effect'>Continue</button>
        <br>
      </div>
    </div>

    
  </div>

  <ul id='drop-domain-ul' class='dropdown-content'>
    <li onclick='drop(0)'><span>Open District Portal</span></li>
    <li onclick='drop(1)'><span>Change District</span></li>
  </ul>

</div>
</div>
  
    

</div>

  


</div>
</div>
    

  </section>
  
  

  <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.8.0/flowbite.min.js"></script>
</body>
</html>